---
import { Icon } from 'astro-icon/components';
---

<nav id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-6 px-8 flex justify-between items-center bg-transparent">
  <div class="text-text font-display font-bold text-2xl tracking-wide uppercase cursor-pointer relative overflow-hidden group">
    <span class="block transition-transform duration-500 group-hover:-translate-y-full">Taltasic</span>
    <span class="block absolute top-0 left-0 transition-transform duration-500 translate-y-full group-hover:translate-y-0 text-accent">Taltasic</span>
  </div>

  <div class="hidden md:flex space-x-8 text-sm font-medium uppercase tracking-widest text-muted">
    {['Home', 'About', 'Services', 'Work'].map((item) => (
      <a href={`#${item.toLowerCase()}`} class="relative group overflow-hidden">
        <span class="block transition-transform duration-300 group-hover:-translate-y-full">{item}</span>
        <span class="block absolute top-0 left-0 transition-transform duration-300 translate-y-full group-hover:translate-y-0 text-text">{item}</span>
        <div class="absolute bottom-0 left-0 w-full h-[1px] bg-text scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></div>
      </a>
    ))}
  </div>

  <div class="flex items-center gap-4">
    <button class="hidden md:flex items-center gap-2 bg-border px-6 py-2 rounded-full hover:bg-muted/20 transition-colors text-sm font-semibold">
      Let's Talk <Icon name="ph:arrow-up-right-bold" class="w-4 h-4" />
    </button>
    <button id="mobile-menu-btn" class="md:hidden text-text p-2" aria-label="Open Menu">
      <Icon name="ph:list" class="w-8 h-8" />
    </button>
  </div>
</nav>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.getElementById('navbar');

  if (nav) {
    ScrollTrigger.create({
      start: 'top -50',
      onUpdate: (self) => {
        if (self.direction === 1) {
          gsap.to(nav, { yPercent: -100, duration: 0.4, ease: "power2.inOut" });
        } else {
          gsap.to(nav, { yPercent: 0, duration: 0.4, ease: "power2.out", backgroundColor: "rgba(15, 15, 15, 0.8)", backdropFilter: "blur(12px)", borderBottom: "1px solid rgba(255,255,255,0.1)" });
        }
        if (self.progress === 0) {
            gsap.to(nav, { backgroundColor: "transparent", backdropFilter: "none", borderBottom: "none", duration: 0.4 });
        }
      }
    });
  }
</script>
