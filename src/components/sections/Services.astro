---
import { Icon } from 'astro-icon/components';

const services = [
  { title: 'Digital Design', desc: 'Crafting pixel-perfect, awwwards-worthy interfaces.', icon: 'ph:palette-duotone' },
  { title: 'Motion & Interaction', desc: 'Bringing life to static designs through GSAP and Three.js.', icon: 'ph:sparkle-duotone' },
  { title: 'Performance Optimization', desc: 'Lightning-fast load times with Astro and modern standards.', icon: 'ph:lightning-duotone' },
  { title: 'Web Development', desc: 'Robust, scalable code architecture tailored for the future.', icon: 'ph:code-duotone' }
];
---

<section id="services" class="py-32 relative bg-bg">
  <div class="container mx-auto px-6 relative z-10">

    <div class="mb-20">
      <h2 class="text-sm font-bold text-accent uppercase tracking-[0.3em] mb-4 flex items-center gap-4" data-reveal="fade-up">
        <span class="w-8 h-[1px] bg-accent"></span> What We Do
      </h2>
      <h3 class="text-4xl md:text-6xl font-display font-bold text-text max-w-2xl leading-tight" data-split="lines">
        Elevating brands through comprehensive digital solutions.
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="services-grid">
      {services.map((svc) => (
        <div class="group relative p-10 bg-surface border border-border rounded-[var(--radius-card)] overflow-hidden transition-transform duration-500 hover:-translate-y-2 service-card">
           <div class="absolute inset-0 bg-[radial-gradient(circle_at_var(--mx,50%)_var(--my,50%),rgba(255,255,255,0.05)_0%,transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

           <div class="relative z-10 flex flex-col h-full">
               <div class="mb-8 p-4 bg-bg inline-block rounded-xl border border-border w-16 h-16 flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500">
                   <Icon name={svc.icon} class="w-8 h-8 text-accent" />
               </div>

               <h4 class="text-2xl font-display font-bold text-text mb-4">{svc.title}</h4>
               <p class="text-muted mb-12 flex-grow">{svc.desc}</p>

               <div class="flex items-center gap-4 text-sm font-bold text-accent group-hover:text-text transition-colors mt-auto w-fit">
                   Explore <Icon name="ph:arrow-up-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
               </div>
           </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import SplitType from "split-type";

  gsap.registerPlugin(ScrollTrigger);

  const splitLines = new SplitType('[data-split="lines"]', { types: 'lines' });
  if(splitLines.lines) {
      gsap.fromTo(splitLines.lines,
        { yPercent: 100, opacity: 0 },
        {
          yPercent: 0,
          opacity: 1,
          stagger: 0.1,
          duration: 1,
          ease: "power4.out",
          scrollTrigger: {
            trigger: '[data-split="lines"]',
            start: "top 85%",
          }
        }
      );
  }

  const cards = document.querySelectorAll('.service-card');
  if(cards.length > 0) {
      gsap.fromTo(cards,
          { y: 50, opacity: 0 },
          {
              y: 0,
              opacity: 1,
              duration: 0.8,
              stagger: 0.15,
              ease: "power3.out",
              scrollTrigger: {
                  trigger: '#services-grid',
                  start: "top 80%",
              }
          }
      );
  }

  // Hover Glow Effect
  cards.forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mx', `${x}px`);
      (card as HTMLElement).style.setProperty('--my', `${y}px`);
    });
  });

</script>
